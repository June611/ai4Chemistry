# Copy to .env.feishu, edit locally, then: source .env.feishu
export FEISHU_APP_ID='cli_replace_me'
export FEISHU_APP_SECRET='replace_me_locally'
export FEISHU_BITABLE_URL='https://your-tenant.feishu.cn/base/replace_me?table=tbl_replace_me'
# Alternatively omit FEISHU_BITABLE_URL and set both IDs below:
# export FEISHU_APP_TOKEN='replace_me'
# export FEISHU_TABLE_ID='tbl_replace_me'
